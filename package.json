{
  "name": "recipes",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "test": "firebase emulators:exec --only firestore --project demo-recipes \"vitest run --no-file-parallelism\"",
    "theme": "node scripts/theme.mjs",
    "icons": "node scripts/icons.mjs",
    "ux": "node scripts/ux/run.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude '**/*.emulator.test.ts' --exclude '**/node_modules/**'"
  },
  "dependencies": {
    "data-platform": "github:nadav-alon/data-platform#v0.28.0",
    "firebase": "^12.19.0",
    "household-ui": "github:nadav-alon/household-ui#v0.5.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@iconify-json/material-symbols": "^1.2.101",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.5",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
